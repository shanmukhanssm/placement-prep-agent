# placement-prep-agent environment — copy to .env and fill in. Never commit .env.
# OpenAI-compatible endpoint; defaults to Groq in config.py if unset.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Required — NVIDIA NIM API key (or any OpenAI-compatible provider key)
LLM_API_KEY=
# Optional override of the model in config.py (e.g. poolside/laguna-xs-2.1 on NVIDIA NIM)
LLM_MODEL=
# Optional per-request LLM timeout in seconds (config.py default 60).
# poolside/laguna-xs-2.1 on NVIDIA NIM measures ~60-77s per response — use >= 180.
LLM_REQUEST_TIMEOUT=180
