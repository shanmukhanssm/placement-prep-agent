# placement-prep-agent environment — copy to .env and fill in. Never commit .env.
# OpenAI-compatible endpoint; defaults to Groq in config.py if unset.
LLM_BASE_URL=https://api.groq.com/openai/v1
# Required — Groq API key (or any OpenAI-compatible provider key)
LLM_API_KEY=
# Optional override of the placeholder model in config.py
LLM_MODEL=
