# placement-prep-agent environment — copy to .env and fill in. Never commit .env.
#
# Provider: xKiro (https://xkiro.com/docs) — OpenAI-compatible gateway.
#   Base URL is https://api.xkiro.com/v1; model IDs are in vendor/model format;
#   free variants carry a ":free" suffix (billed to the daily free-token quota,
#   not the wallet).
# The repo uses langchain_openai.ChatOpenAI (Chat Completions + bind_tools +
# tool_choice="required"), so the model must support OpenAI tool calling.
LLM_BASE_URL=https://api.xkiro.com/v1

# Required — xKiro API key (get one at https://xkiro.com).
LLM_API_KEY=

# Model ID in vendor/model format; ":free" suffix uses the daily free-token quota.
# Tool-calling-capable examples on xKiro:
#   qwen/qwen3.7-max:free      (current live config)
#   qwen/qwen3.5-flash:free    (faster/cheaper fallback)
LLM_MODEL=qwen/qwen3.7-max:free

# Optional per-request LLM timeout in seconds (config.py default 60).
# 60s is fine for xKiro; raise it if you switch to a slower provider.
# NOTE: leave the value non-blank — config.py guards against LLM_REQUEST_TIMEOUT=
# copied verbatim from this file, but a filled value avoids the fallback path.
LLM_REQUEST_TIMEOUT=60

# --- Alternative provider presets -------------------------------------------
# If unset, config.py falls back to Groq:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
# NVIDIA NIM (used in earlier phases; slower, needs a larger timeout, e.g. 180):
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_MODEL=poolside/laguna-xs-2.1
